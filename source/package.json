{
  "name": "fable",
  "private": true,
  "version": "5.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "npm run -s server:build && node dist/server.mjs",
    "server:build": "esbuild server/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --external:ws",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test:save": "esbuild tests/save.test.ts --bundle --platform=node --format=esm --outfile=dist/save.test.mjs --log-level=warning && node dist/save.test.mjs",
    "test:inventory": "esbuild tests/inventory.test.ts --bundle --platform=node --format=esm --outfile=dist/inventory.test.mjs --log-level=warning && node dist/inventory.test.mjs",
    "test:physics": "esbuild tests/physics.test.ts --bundle --platform=node --format=esm --outfile=dist/physics.test.mjs --log-level=warning && node dist/physics.test.mjs",
    "test": "npm run -s test:save && npm run -s test:inventory && npm run -s test:physics && npm run -s test:validate && npm run -s test:pack && npm run -s test:hand && npm run -s test:survival && npm run -s test:mesher && npm run -s test:signal && npm run -s test:brewing && npm run -s test:pail && npm run -s test:blade && npm run -s test:vehicles && npm run -s test:dom && npm run -s test:building && npm run -s test:heldpose && npm run -s test:gamma",
    "build:site": "npm run -s build && node tools/build-site.mjs",
    "preview:site": "node tools/serve-site.mjs",
    "desktop": "cd desktop && npm install && npm start",
    "desktop:build": "npm run -s build && cd desktop && npm install && npm run dist",
    "test:pack": "node tools/packload-build.mjs && node dist/packload.test.mjs",
    "test:hand": "node tools/handmodel-build.mjs && node dist/handmodel.test.mjs",
    "test:validate": "node tools/validate-build.mjs && node dist/validate.test.mjs",
    "test:survival": "node tools/survival-build.mjs && node dist/survival.test.mjs",
    "test:mesher": "node tools/mesher-build.mjs && node dist/mesher.test.mjs",
    "bench:tris": "node tools/tris-build.mjs && node dist/trisbench.mjs",
    "test:signal": "node tools/signal-build.mjs && node dist/signal.test.mjs",
    "test:brewing": "node tools/brewing-build.mjs && node dist/brewing.test.mjs",
    "test:pail": "node tools/pail-build.mjs && node dist/pail.test.mjs",
    "test:blade": "node tools/blade-build.mjs && node dist/blade.test.mjs",
    "test:vehicles": "node tools/vehicles-build.mjs && node dist/vehicles.test.mjs",
    "test:dom": "node tools/build-dom-test.mjs && node run-dom.mjs",
    "test:building": "node tools/building-build.mjs && node dist/building.test.mjs",
    "test:heldpose": "node tools/heldpose-build.mjs && node run-heldpose.mjs",
    "test:gamma": "node tools/gamma-build.mjs && node dist/gamma.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/three": "^0.185.4",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^24.1.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
